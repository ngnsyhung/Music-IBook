          "lastPositionSecond": {
            "type": "number",
            "format": "double"
          },
          "completedNoteCount": {
            "type": "integer",
            "format": "int32"
          },
          "bestScore": {
            "type": "integer",
            "format": "int32"
          },
          "isCompleted": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "SubmitNoteAttemptRequest": {
        "type": "object",
        "properties": {
          "lessonNoteId": {
            "type": "integer",
            "format": "int64"
          },
          "playedNote": {
            "type": "string",
            "nullable": true
          },
          "playedAtSecond": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "SubmitPracticeRequest": {
        "type": "object",
        "properties": {
          "lessonId": {
            "type": "integer",
            "format": "int64"
          },
          "isExam": {
            "type": "boolean"
          },
          "durationSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubmitNoteAttemptRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
