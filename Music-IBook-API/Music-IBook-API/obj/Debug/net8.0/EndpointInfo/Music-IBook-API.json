          "newPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SaveLessonContentRequest": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddLessonNoteRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SaveProgressRequest": {
        "type": "object",
